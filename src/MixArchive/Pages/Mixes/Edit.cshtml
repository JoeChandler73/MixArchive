@page "{id:int}"
@model MixArchive.Pages.Mixes.EditModel

@{
    ViewData["Title"] = "Edit Mix";
}

<div class="mb-4">
    <a asp-page="/Mixes/Details"
       asp-route-id="@Model.Id"
       class="text-decoration-none">
        ← Back to mix
    </a>
</div>

<h1>Edit Mix</h1>

<form method="post" enctype="multipart/form-data">

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Title" class="form-label">
            Title
        </label>

        <input asp-for="Title"
               class="form-control"
               autofocus />

        <span asp-validation-for="Title"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">
            Description
        </label>

        <textarea asp-for="Description"
                  class="form-control"
                  rows="5"></textarea>
    </div>

    <div class="mb-4">
      <label class="form-label">Tags</label>

      <div id="tag-editor"
        class="form-control d-flex flex-wrap gap-2 align-items-center"
        style="min-height: 42px; cursor: text;">

        <div id="tag-list"
          class="d-flex flex-wrap gap-2">
        </div>

        <input id="tag-input"
          type="text"
          class="border-0 flex-grow-1"
          style="outline: none; min-width: 120px;"
          placeholder="Add a tag..." />
      </div>

      <input asp-for="Tags" type="hidden" id="tags-hidden" />

      <div class="form-text">
        Type a tag and press Enter.
      </div>
    </div>

    <div class="mb-4">
      <label asp-for="Artwork" class="form-label">
        Artwork
      </label>

      @if (!string.IsNullOrWhiteSpace(Model.ArtworkFileName))
      {
        <div class="mb-3">
          <img src="?handler=Artwork"
            class="img-thumbnail"
            style="max-width: 300px; max-height: 300px;"
            alt="Current artwork" />
        </div>

        <div class="form-check mb-3">
          <input asp-for="RemoveArtwork" class="form-check-input" />
          <label asp-for="RemoveArtwork"class="form-check-label">
            Remove artwork
          </label>
        </div>
      }

      <input asp-for="Artwork"
        type="file"
        class="form-control"
        accept=".jpg,.jpeg,.png,.webp" />

      <div class="form-text">
        Optional. JPEG, PNG or WebP, maximum 5 MB.
        Uploading a new image replaces the existing artwork.
      </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit"
                class="btn btn-primary">
            Save Changes
        </button>

        <a asp-page="/Mixes/Details"
           asp-route-id="@Model.Id"
           class="btn btn-outline-secondary">
            Cancel
        </a>
    </div>

</form>

@section Scripts {
  <partial name="_ValidationScriptsPartial" />

  <script>
    const editor = document.getElementById('tag-editor');
    const tagList = document.getElementById('tag-list');
    const tagInput = document.getElementById('tag-input');
    const hiddenInput = document.getElementById('tags-hidden');

    let tags = [];

    function normaliseTag(value) {
      return value.trim().toLowerCase();
    }

    function renderTags() {
      tagList.innerHTML = '';

      tags.forEach((tag, index) => {
        const chip = document.createElement('span');

        chip.className =
          'badge text-bg-secondary d-flex align-items-center gap-1';

        chip.innerHTML = `
          ${escapeHtml(tag)}
          <button type="button"
            class="btn-close btn-close-white"
            style="font-size: 0.55rem;"
            aria-label="Remove ${escapeHtml(tag)}"
            data-index="${index}">
          </button>
        `;

        tagList.appendChild(chip);
      });

      hiddenInput.value = tags.join(',');
    }

    function addTag(value) {
      const tag = normaliseTag(value);

      if (!tag)
        return;

      if (!tags.includes(tag))
        tags.push(tag);

      tagInput.value = '';
      renderTags();
    }

    function removeTag(index) {
      tags.splice(index, 1);
      renderTags();
    }

    function escapeHtml(value) {
      const div = document.createElement('div');
      div.textContent = value;
      return div.innerHTML;
    }

    tagInput.addEventListener('keydown', event => {
      if (event.key === 'Enter' || event.key === ',') {
        event.preventDefault();
        addTag(tagInput.value);
      }

      if (event.key === 'Backspace' &&
        tagInput.value === '' &&
        tags.length > 0) {
          tags.pop();
          renderTags();
        }
    });

    tagList.addEventListener('click', event => {
      const button = event.target.closest('button');

      if (!button)
        return;

      removeTag(Number(button.dataset.index));
    });

    editor.addEventListener('click', () => {
      tagInput.focus();
    });

    // Initialise from the value supplied by the server.
    const initialTags = hiddenInput.value
      .split(',')
      .map(normaliseTag)
      .filter(tag => tag.length > 0);

      tags = [...new Set(initialTags)];

      renderTags();
  </script>
}

